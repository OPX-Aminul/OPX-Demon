CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_NET_DRIVERS=y

# loop/squashfs/overlay: the guest needs /dev/loop* + squashfs to mount
# .img/.iso payloads and to unpack modules when /lib/modules is missing.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLOCK=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y

CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

CONFIG_NETDEVICES=y
CONFIG_NET_RADIO=y

CONFIG_ATH_CARDS=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y

CONFIG_MT7601U=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y

CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT2800_LIB=y

CONFIG_RTL8187=y
CONFIG_RTLWIFI=y
CONFIG_RTL8XXXU=y
CONFIG_RTW88=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8812AU=y

CONFIG_ZD1211RW=y

CONFIG_SERIAL_AMBA_PL011=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_RNG=y
CONFIG_VIRTIO_9P=y
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_9P_VIRTIO=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_9P_FS_SECURITY=y
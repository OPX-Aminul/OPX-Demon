<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_bar"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:background="@drawable/bottom_nav_bg"
    android:elevation="10dp">

    <!-- Animated gold pill that slides between the active destinations -->
    <View
        android:id="@+id/bottom_nav_indicator"
        android:layout_width="46dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="7dp"
        android:background="@drawable/bottom_nav_indicator"
        android:alpha="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/home"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Terminal -->
        <LinearLayout
            android:id="@+id/nav_terminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_terminal_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/terminal"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_terminal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_terminal"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tools — raised gold hub button that opens the full tool drawer -->
        <LinearLayout
            android:id="@+id/nav_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="-14dp"
                android:background="@drawable/nav_plus_bg"
                android:elevation="6dp">

                <ImageView
                    android:id="@+id/nav_add_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/add"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_add_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="@string/nav_tools"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Logs -->
        <LinearLayout
            android:id="@+id/nav_logs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_logs_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/bug_report"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_logs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_logs"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- About -->
        <LinearLayout
            android:id="@+id/nav_about"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_about_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/info_outlined"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_about_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_about"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
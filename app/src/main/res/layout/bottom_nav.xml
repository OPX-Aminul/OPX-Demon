<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_bar"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bottom_nav_bg"
    android:elevation="12dp">

    <!-- Sliding gold pill that glides under the active tab -->
    <View
        android:id="@+id/bottom_nav_indicator"
        android:layout_width="52dp"
        android:layout_height="4dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="2dp"
        android:background="@drawable/bottom_nav_indicator"
        android:alpha="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/home"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_home"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tools — opens the full tool grid sheet -->
        <LinearLayout
            android:id="@+id/nav_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/nav_plus_bg">

                <ImageView
                    android:id="@+id/nav_tools_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/apps_grid"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_tools_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tools"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Terminal -->
        <LinearLayout
            android:id="@+id/nav_terminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_terminal_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/terminal"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_terminal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_terminal"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Logs -->
        <LinearLayout
            android:id="@+id/nav_logs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_logs_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/bug_report"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_logs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_logs"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Settings — opens the full settings screen -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/settings"
                app:tint="@color/grey" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_settings"
                android:textColor="@color/grey"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

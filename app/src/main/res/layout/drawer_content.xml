<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/drawer_logo_bg">

                <ImageView
                    android:id="@+id/drawer_logo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/app_logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato"
                    android:letterSpacing="0.02"
                    android:text="OPX-Demon"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/drawer_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="v6.0"
                    android:textColor="@color/opxdemon_accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/menu_close_drawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/close"
                app:tint="@color/grey" />
        </LinearLayout>

        <!-- Engine status card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/light_contrast"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_lite_contrast"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp">

                <FrameLayout
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/status_dot_ring">

                    <View
                        android:id="@+id/drawer_status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:background="@drawable/sev_dot_bg"
                        android:backgroundTint="@color/green" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/drawer_chroot_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Chroot mounted"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/drawer_arch_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_value_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="arm64"
                    android:textColor="@color/opxdemon_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="@drawable/section_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="ESSENTIALS"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/dasboard_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/terminal_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/logs_item"
            layout="@layout/drawer_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="@drawable/section_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="WIRELESS"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/wifi_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/hs_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/wpair_item"
            layout="@layout/drawer_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="@drawable/section_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="NETWORK"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/lan_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/nmap_item"
            layout="@layout/drawer_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="@drawable/section_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="OFFENSIVE"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/nuclei_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/arsenal_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/metasploit_item"
            layout="@layout/drawer_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="@drawable/section_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="TOOLS"
                android:textAllCaps="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <include
            android:id="@+id/geomac_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/vnc_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/manager_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/about_item"
            layout="@layout/drawer_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:background="@drawable/section_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/root_section_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="ROOT"
                android:textAllCaps="true"
                android:textColor="@color/red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/root_section_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="6dp"
            android:text="Need the phone's own radio/USB gadget — unavailable on the rootless VM"
            android:textColor="@color/grey"
            android:textSize="10sp"
            android:visibility="gone" />

        <include
            android:id="@+id/hid_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/usb_arsenal_item"
            layout="@layout/drawer_row" />

        <include
            android:id="@+id/macchanger_item"
            layout="@layout/drawer_row" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="14dp"
            android:background="@color/light_lite_contrast" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="Open-source · authorized testing only"
            android:textColor="@color/grey"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>